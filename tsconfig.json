{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "./public",
    "esModuleInterop": true,
    "sourceMap": true,
    "paths": {
      "@services/*": ["./src/routes/*"],
      "@common/*": ["./src/common/*"],
      "@prismaGenerated/*": ["./src/generated/prisma/*"]
    },
    "types": ["@types/jest"],
    "lib": ["es2022"]
  },
  "ts-node": {
    // Do not forget to `npm i -D tsconfig-paths`
    "require": ["tsconfig-paths/register"]
  },
  "include": ["src"]
}
